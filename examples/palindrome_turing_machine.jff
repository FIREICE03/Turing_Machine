<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for Module 5 - Turing Machine Simulator (JFLAP Compatible) -->
<!-- Topic: Binary Palindrome Recognition on Single Tape -->
<structure>
	<type>turing</type>
	<automaton>
		<!-- The list of states. -->
		<state id="0" name="accept">
			<x>516.0</x>
			<y>78.0</y>
			<final/>
		</state>
		<state id="1" name="haveA">
			<x>192.0</x>
			<y>252.0</y>
		</state>
		<state id="2" name="start">
			<x>516.0</x>
			<y>252.0</y>
			<initial/>
		</state>
		<state id="3" name="haveB">
			<x>840.0</x>
			<y>252.0</y>
		</state>
		<state id="4" name="matchA">
			<x>192.0</x>
			<y>462.0</y>
		</state>
		<state id="5" name="back">
			<x>516.0</x>
			<y>462.0</y>
		</state>
		<state id="6" name="matchB">
			<x>840.0</x>
			<y>462.0</y>
		</state>
		<state id="7" name="reject">
			<x>516.0</x>
			<y>618.0</y>
		</state>
		<!-- The list of transitions. -->
		<transition>
			<from>2</from>
			<to>1</to>
			<read>0</read>
			<write/>
			<move>R</move>
		</transition>
		<transition>
			<from>2</from>
			<to>3</to>
			<read>1</read>
			<write/>
			<move>R</move>
		</transition>
		<transition>
			<from>2</from>
			<to>0</to>
			<read/>
			<write/>
			<move>S</move>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>0</read>
			<write>0</write>
			<move>R</move>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>1</read>
			<write>1</write>
			<move>R</move>
		</transition>
		<transition>
			<from>1</from>
			<to>4</to>
			<read/>
			<write/>
			<move>L</move>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>0</read>
			<write>0</write>
			<move>R</move>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>1</read>
			<write>1</write>
			<move>R</move>
		</transition>
		<transition>
			<from>3</from>
			<to>6</to>
			<read/>
			<write/>
			<move>L</move>
		</transition>
		<transition>
			<from>4</from>
			<to>5</to>
			<read>0</read>
			<write/>
			<move>L</move>
		</transition>
		<transition>
			<from>4</from>
			<to>0</to>
			<read/>
			<write/>
			<move>S</move>
		</transition>
		<transition>
			<from>4</from>
			<to>7</to>
			<read>1</read>
			<write>1</write>
			<move>S</move>
		</transition>
		<transition>
			<from>6</from>
			<to>5</to>
			<read>1</read>
			<write/>
			<move>L</move>
		</transition>
		<transition>
			<from>6</from>
			<to>0</to>
			<read/>
			<write/>
			<move>S</move>
		</transition>
		<transition>
			<from>6</from>
			<to>7</to>
			<read>0</read>
			<write>0</write>
			<move>S</move>
		</transition>
		<transition>
			<from>5</from>
			<to>5</to>
			<read>0</read>
			<write>0</write>
			<move>L</move>
